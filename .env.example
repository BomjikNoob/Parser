# Скопируй в .env и заполни
BOT_TOKEN=123456:ABC...
# id через запятую (бот пишет твой id в /start). Первый — админ: только он управляет общими прокси в /proxy.
# Пусто = бот отвечает всем (в логе будет предупреждение).
ALLOWED_USERS=
POLL_INTERVAL=60
# Общий прокси для всех площадок: http://user:pass@host:port,socks5://host:port — ротация по кругу.
# Прокси для площадки или страны (Depop GB, Vinted US, OLX UA…) назначается в боте командой /proxy: у каждого
# пользователя свои (другие их не видят и не тратят), админ может добавить общие — для тех, у кого своего нет.
# Порядок: свой → общий из /proxy → PROXIES отсюда. Depop режет домашние и датацентровые IP — нужны резидентские.
PROXIES=
# Часовой пояс для времени в карточках (IANA): Europe/Moscow, Europe/Madrid… Пусто = пояс компьютера.
TIMEZONE=
