# Скопируй в .env и заполни
BOT_TOKEN=123456:ABC...
# id через запятую (бот пишет твой id в /start). Пусто = бот отвечает всем (в логе будет предупреждение).
ALLOWED_USERS=
POLL_INTERVAL=60
# Общий прокси для всех площадок: http://user:pass@host:port,socks5://host:port — ротация по кругу.
# Свой прокси для площадки или страны (Depop GB, Vinted US, OLX UA…) назначается в боте командой /proxy
# и важнее общего. Depop режет домашние и датацентровые IP — нужны резидентские.
PROXIES=
# Часовой пояс для времени в карточках (IANA): Europe/Moscow, Europe/Madrid… Пусто = пояс компьютера.
TIMEZONE=
